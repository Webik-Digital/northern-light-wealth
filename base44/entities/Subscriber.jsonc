// The Four Turnings mailing list.
//
// Anyone may subscribe; the list itself is an admin's to see. An email address
// given to receive a letter is not a public record.
{
  "name": "Subscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "source": {
      "type": "string",
      "default": "the-four-turnings"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": true,
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
