// The client library.
//
// Read is for signed-in people only: there is no anonymous role, so a visitor
// who has not signed in matches neither arm of the $or and the rows are never
// served. The gate is here rather than in the page, so hiding the list in the
// UI is not what keeps it private.
{
  "name": "Resource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fileOrUrl": {
      "type": "string"
    },
    "thumbnailUrl": {
      "type": "string",
      "description": "Cover image for the card, usually the first page of the document"
    },
    "isGated": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
