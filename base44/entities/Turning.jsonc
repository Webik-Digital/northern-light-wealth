{
  "name": "Turning",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "season": {
      "type": "string",
      "enum": [
        "spring",
        "summer",
        "fall",
        "winter"
      ]
    },
    "year": {
      "type": "number"
    },
    "marker": {
      "type": "string",
      "description": "Solstice or equinox wording, e.g. 'Summer Solstice'"
    },
    "slug": {
      "type": "string"
    },
    "dek": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Optional short summary shown under the standfirst"
    },
    "pdfUrl": {
      "type": "string",
      "description": "The issue as a PDF"
    },
    "webUrl": {
      "type": "string",
      "description": "Optional web version of the issue"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "season",
    "year",
    "slug"
  ]
}